#!/usr/bin/env python3
"""forge-test N: run slice N's checkpoint, exactly as the approved plan.md states it.

The commands come from plan.md, not from the caller. `pytest ...` runs as
`.venv/bin/python -m pytest ...` and `python ...` as `.venv/bin/python ...`.
Before running, it checks that the design (design.md + plan.md) is still approved and
that tests/ is byte-identical to what was locked. The result is written to
pipeline/slices/slice-N.tests.json, together with a snapshot of the project files,
so the build workflow and the user see what really happened. Exit 0 only if every
command passed.
"""

from __future__ import annotations

import datetime as dt
import json
import shlex
import subprocess
import sys
from pathlib import Path

LIB = Path(__file__).resolve().parents[1] / "lib"
sys.path.insert(0, str(LIB))
import forge_approvals as fa  # noqa: E402
import forge_build as fb  # noqa: E402

TIMEOUT = 900  # seconds per command


def main(argv: list[str]) -> int:
    if len(argv) != 1 or not argv[0].isdigit():
        print("usage: forge-test N   (runs slice N's checkpoint from pipeline/plan.md)")
        return 2
    n = int(argv[0])
    root = fb.find_root()
    if root is None:
        print("FAIL: not inside a forge project")
        return 1
    rec = {"slice": n, "ran_at": dt.datetime.now().isoformat(timespec="seconds"), "passed": False,
           "reason": "", "commands": [], "tests_intact": False, "files": {}}
    out = fb.slices_dir(root) / f"slice-{n}.tests.json"

    def finish(reason: str = "") -> int:
        rec["reason"] = reason
        rec["files"] = fb.snapshot(root)
        out.write_text(json.dumps(rec, indent=1) + "\n", encoding="utf-8")
        status = "PASS" if rec["passed"] else "FAIL"
        print(f"{status}: slice {n} checkpoint" + (f" ({reason})" if reason else ""))
        for c in rec["commands"]:
            print(f"  [{'ok' if c['exit'] == 0 else 'exit ' + str(c['exit'])}] {c['command']}")
        print(f"record: {out.relative_to(root)}")
        return 0 if rec["passed"] else 1

    ok, why = fa.check(root, "design")
    if not ok:
        return finish(f"design not approved: {why}")
    locked, intact, why = fa.tests_lock_state(root)
    rec["tests_intact"] = intact
    if not intact:
        return finish(why)
    slices = {s["n"]: s for s in fb.parse_slices((root / "pipeline" / "plan.md").read_text(encoding="utf-8"))}
    if n not in slices:
        return finish(f"plan.md has no 'Slice {n}'")
    cmds = slices[n]["commands"]
    if not cmds:
        return finish(f"plan.md's Slice {n} has no runnable checkpoint command")
    py = root / ".venv" / "bin" / "python"
    if not py.is_file():
        return finish("no .venv: create it (python3 -m venv .venv) and install the plan's dependencies first")

    for cmd in cmds:
        words = shlex.split(cmd)
        if words[0] == "pytest":
            words = [str(py), "-m", "pytest", *words[1:]]
        elif words[0] in ("python", "python3"):
            words = [str(py), *words[1:]]
        try:
            p = subprocess.run(words, cwd=root, capture_output=True, text=True, timeout=TIMEOUT)
            code, text = p.returncode, (p.stdout + p.stderr)
        except subprocess.TimeoutExpired as e:
            code, text = 124, f"timed out after {TIMEOUT}s\n{(e.stdout or '')}{(e.stderr or '')}"
        tail = "\n".join(str(text).splitlines()[-40:])
        rec["commands"].append({"command": cmd, "exit": code, "tail": tail})
        if code != 0:
            break  # later commands depend on earlier ones

    # tests/ must still be intact after running (a run must not modify tests)
    locked, intact, why = fa.tests_lock_state(root)
    rec["tests_intact"] = intact
    if not intact:
        return finish(why)
    rec["passed"] = len(rec["commands"]) == len(cmds) and all(c["exit"] == 0 for c in rec["commands"])
    return finish("" if rec["passed"] else "a checkpoint command failed")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
